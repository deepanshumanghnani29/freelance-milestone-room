# Copy this file to .env and fill in your real values.
# Never commit .env or any real credentials, tokens, or identity data.

# MongoDB connection string (e.g. mongodb://localhost:27017/milestone-room)
MONGODB_URI=

# NamoID OpenID Connect issuer URL (from the NamoID Console)
NAMOID_ISSUER=

# OAuth 2.0 Client ID (from the NamoID Console)
NAMOID_CLIENT_ID=

# OAuth 2.0 Client Secret — KEEP THIS ON THE SERVER ONLY
NAMOID_CLIENT_SECRET=

# A long random string used to sign the session cookie
SESSION_SECRET=

# The public URL where your React app runs
APP_BASE_URL=http://localhost:5174

# The port the Express server listens on
SERVER_PORT=4000
