# Copy this file to .env in the repository root and fill in your real values.
# Never commit .env or any real credentials, tokens, or identity data.
# The server loads ../.env automatically via Node's --env-file flag.

# NamoID Client ID (from the NamoID Console).
# @namoidhq/js discovers the issuer, authorization URL, and JWKS
# automatically from this ID — no NAMOID_ISSUER variable needed.
NAMOID_CLIENT_ID=

# NamoID Client Secret — KEEP THIS ON THE SERVER ONLY. Never send to the browser.
NAMOID_CLIENT_SECRET=

# A long random string used to sign the session cookie.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters. Server refuses to start otherwise.
SESSION_SECRET=

# The public URL where your React app runs (no trailing slash).
APP_BASE_URL=http://localhost:5174

# The port the Express server listens on.

# MongoDB connection string — leave blank until Phase 3.
MONGODB_URI=
